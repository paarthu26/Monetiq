# ---------------------------------------------------------------------------
# Monetiq — environment variables
# Copy to `.env.local` and fill in. Never commit a filled-in file.
# ---------------------------------------------------------------------------

# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose to the browser; it is only
# useful in combination with Row Level Security, which is enabled on every
# application table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-ONLY. Never import this into any module
# reachable from client-side code, never prefix it with NEXT_PUBLIC_.
# Used by server actions / route handlers and injected automatically into
# Edge Functions by Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build Supabase Auth redirect targets (email verification,
# password reset, Google OAuth callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider keys are deliberately NOT environment variables.
# They are managed through the Super Admin AI Key Management screen, stored in
# Supabase Vault, and read only by Edge Functions running with the service
# role (see supabase/functions/manage-ai-key and supabase/functions/ai-chat).
# Do not add provider keys here.
# ---------------------------------------------------------------------------

# Optional: OCR provider used by the process-receipt Edge Function.
# Phase 1 ships a pluggable stub provider; set to a real provider slug once a
# credential exists. Configured as an Edge Function secret, not a client env
# var: `supabase secrets set OCR_PROVIDER=... OCR_PROVIDER_API_KEY=...`
# OCR_PROVIDER=stub
